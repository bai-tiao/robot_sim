<?xml version="1.0"?>
<!-- ============================================================
     小车物理参数定义文件
     robot_params.xacro
     
     【TODO】根据实际小车测量参数修改以下宏定义
     ============================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =================== 底盘参数 ===================
       D1 平台实测参数:
         chassis_radius : 底盘半径 406mm/2 = 0.203m
         chassis_height : 底盘高度 209.5mm
         chassis_mass   : 自重 20kg
  -->
  <xacro:property name="chassis_radius"   value="0.203"/>
  <xacro:property name="chassis_height"   value="0.2095"/>
  <xacro:property name="chassis_mass"     value="20.0"/>

  <!-- =================== 驱动轮参数 ===================
       D1 图纸实测参数:
         wheel_radius   : 驱动轮 Φ125mm → 半径 0.0625m
         wheel_width    : 轮宽 ~0.04m (待实测)
         wheel_mass     : 单轮质量估算 ~1.0kg
         wheel_y_offset : 轮距/2 = 350.7mm/2 = 0.17535m
  -->
  <xacro:property name="wheel_radius"     value="0.0625"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="1.0"/>
  <xacro:property name="wheel_y_offset"   value="0.17535"/>
  <xacro:property name="wheel_x_offset"   value="0.0"/>

  <!-- =================== 万向支撑轮参数 ===================
       D1 万向轮: 1寸 = 25.4mm直径, 半径 0.0127m
       布局: 前居中 + 后居中 各1个
         caster_y_offset = 0 (居中布局)
  -->
  <xacro:property name="caster_radius"    value="0.0127"/>
  <xacro:property name="caster_mass"      value="0.1"/>
  <xacro:property name="caster_x_front"   value="0.15"/>
  <xacro:property name="caster_x_rear"    value="-0.15"/>
  <xacro:property name="caster_y_offset"  value="0.0"/>

  <!-- =================== 底盘离地高度 ===================
       D1文档: 离地高度 38mm
       chassis_z_offset = 离地高度 + chassis_height/2
       = 0.038 + 0.2095/2 = 0.14275m
       (base_link原点在底盘几何中心)
  -->
  <xacro:property name="chassis_z_offset" value="${0.038 + chassis_height/2}"/>

  <!-- =================== 上层圆盘平台参数 ===================
       4根柱子支撑上层圆盘, 外观参考实物图:
         pillar_height   : 柱子高度 ≈ chassis_height * 0.6
         pillar_radius   : 细圆柱半径
         pillar_xy_offset: 柱子分布在圆盘半径70%处
         top_plate_radius: 上层圆盘半径 = chassis_radius
         top_plate_height: 上层圆盘厚度
  -->
  <xacro:property name="pillar_height"     value="${chassis_height * 0.6}"/>
  <xacro:property name="pillar_radius"     value="0.015"/>
  <xacro:property name="pillar_mass"       value="0.5"/>
  <xacro:property name="pillar_xy_offset"  value="${chassis_radius * 0.7}"/>
  <xacro:property name="top_plate_radius"  value="${chassis_radius}"/>
  <xacro:property name="top_plate_height"  value="0.008"/>
  <xacro:property name="top_plate_mass"    value="1.0"/>

  <!-- =================== 3D激光雷达安装参数 ===================
       雷达位置由外参标定 + 相机已知位置反推:
         相机已知(top_plate坐标系): x=0.15, y=0.0, z=0.019
         雷达位置 = 相机位置 - R_pitch(-28.3°) × t
         结果: lidar_x=-0.006m, lidar_y=-0.037m, z=0.027m
         即雷达在相机后方偏右、几乎等高，与实物图吹合
       rpy pitch=-0.4947 rad (-28.3°): 由外参矩阵第3列反推
  -->
  <xacro:property name="lidar_x"          value="0.10"/>
  <xacro:property name="lidar_y"          value="0.0"/>
  <!-- lidar_z 已废弃, 由 sensors.xacro 中 joint origin 直接计算 -->
  <xacro:property name="lidar_mass"       value="0.83"/>
  <xacro:property name="lidar_radius"     value="0.04"/>
  <xacro:property name="lidar_height"     value="0.06"/>

  <!-- =================== 深度相机安装参数 ===================
       安装在上层圆盘前沿:
         camera_x = 0.15m (圆盘前沿内侧)
         camera_y = 0.0   (居中)
       camera z/高度由 sensors.xacro 中 camera_joint 计算
       【TODO】相机安装高度以实际支架为准
  -->
  <xacro:property name="camera_x"         value="0.15"/>
  <xacro:property name="camera_y"         value="0.0"/>
  <xacro:property name="camera_mass"      value="0.15"/>
  <xacro:property name="camera_size_x"    value="0.03"/>
  <xacro:property name="camera_size_y"    value="0.09"/>
  <xacro:property name="camera_size_z"    value="0.03"/>

  <!-- =================== IMU安装参数 ===================
       【TODO】若有IMU则根据实际安装位置修改:
         IMU一般安装在底盘中心附近以减少杠杆效应引入的误差
  -->
  <xacro:property name="imu_x"            value="0.0"/>
  <xacro:property name="imu_y"            value="0.0"/>
  <xacro:property name="imu_z"            value="${chassis_height/2}"/>
  <xacro:property name="imu_mass"         value="0.01"/>

  <!-- =================== 惯性矩辅助宏 ===================
       以下宏用于生成常见几何体的惯性矩阵
       一般不需要修改
  -->

  <!-- 实心长方体 (box) 的惯性矩:
       m  : 质量
       dx : X方向尺寸
       dy : Y方向尺寸
       dz : Z方向尺寸
  -->
  <xacro:macro name="box_inertia" params="m dx dy dz">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(dy*dy + dz*dz)/12.0}"  ixy="0.0" ixz="0.0"
        iyy="${m*(dx*dx + dz*dz)/12.0}"  iyz="0.0"
        izz="${m*(dx*dx + dy*dy)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 实心圆柱体 (cylinder) 的惯性矩:
       m  : 质量
       r  : 半径
       h  : 高度(轴向长度)
  -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r + h*h)/12.0}"  ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r + h*h)/12.0}"  iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 实心球体 (sphere) 的惯性矩:
       m  : 质量
       r  : 半径
  -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2*m*r*r/5.0}"  ixy="0.0" ixz="0.0"
        iyy="${2*m*r*r/5.0}"  iyz="0.0"
        izz="${2*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

</robot>
