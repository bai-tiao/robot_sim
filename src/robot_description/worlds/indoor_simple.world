<?xml version="1.0"?>
<!--
  indoor_simple.world
  ===================
  室内仿真场景: 8m x 6m 封闭房间 + 内墙隔断 + 障碍物
  完全使用 SDF 原生几何体, 无需在线下载模型

  布局 (俯视):
    ┌────────────────────────────────────┐
    │              │  y=+3               │
    │   大厅(西)   │       小房间(东北)   │
    │  起点(0,0)   │门                   │
    │             ─┘    走廊            │
    │              └─                   │
    │   杂物区(西南)│       小房间(东南)   │
    │              │  y=-3               │
    └────────────────────────────────────┘
     x=-4                              x=+4

  【TODO】换更精细环境时修改 gazebo_sim.launch.py 的 world 参数:
    ros2 launch robot_description gazebo_sim.launch.py world:=/path/to/your.world
-->
<sdf version="1.6">
  <world name="indoor_simple">

    <!-- ========== 物理引擎参数 ========== -->
    <physics name="default_physics" default="true" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ========== 光源 ========== -->
    <light name="ceiling_light" type="point">
      <pose>0 0 4 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range><constant>0.5</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- ========== 地面 ========== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Floor</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         外墙: 8m(x) × 6m(y), 中心在原点, 墙高2.5m, 厚0.15m
         ================================================================ -->
    <!-- 北墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
    <!-- 南墙 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.15 0.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
    <!-- 东墙 -->
    <model name="wall_east">
      <static>true</static>
      <pose>4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 6.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>
    <!-- 西墙 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 6.15 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         内墙隔断: x=0.5 纵向隔墙, 在 y=[-0.5, 0.5] 留1m宽门洞
         ================================================================ -->
    <!-- 内墙北段 -->
    <model name="inner_wall_north">
      <static>true</static>
      <pose>0.5 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 2.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 2.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- 内墙南段 -->
    <model name="inner_wall_south">
      <static>true</static>
      <pose>0.5 -1.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 2.5 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 2.5 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- 门洞过梁 -->
    <model name="door_lintel">
      <static>true</static>
      <pose>0.5 0.0 2.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 1.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 1.0 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         障碍物
         ================================================================ -->
    <!-- 大箱子: 西北角 -->
    <model name="box_large">
      <static>true</static>
      <pose>-2.5 2.0 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 小箱子: 东南 -->
    <model name="box_small">
      <static>true</static>
      <pose>2.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 圆柱障碍: 西侧走廊 -->
    <model name="cylinder_pillar">
      <static>true</static>
      <pose>-1.5 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 长条障碍: 东侧 -->
    <model name="bench">
      <static>true</static>
      <pose>2.5 0.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.3 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.3 0.4</size></box></geometry>
          <material><ambient>0.5 0.35 0.1 1</ambient><diffuse>0.5 0.35 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== 场景设置 ========== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- GUI 初始视角 (俯视45°) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-2 -8 6 0 0.6 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
